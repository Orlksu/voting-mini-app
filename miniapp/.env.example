# Скопируйте этот файл в miniapp/.env и заполните значения.
# Реальные секреты в репозиторий не добавляйте.

# --- Telegram bot -----------------------------------------------------------
# Токен из @BotFather. Без него backend всё равно запускается,
# но проверка Telegram initData недоступна, а bot.py не стартует.
BOT_TOKEN=123456:replace_me

# Telegram ID главного администратора. При старте backend/bot пользователь
# получает role=admin, если ещё не назначен в базе вручную.
ADMIN_TG_ID=

# Один или несколько кодов через запятую: /start invite_pass
INVITE_CODE=invite_pass

# Публичный HTTPS-адрес Mini App для кнопок бота.
# Локально можно указать http://127.0.0.1:8000/ — Telegram откроет его
# как обычную ссылку, а не как Web App.
MINIAPP_URL=http://127.0.0.1:8000/

# --- Database ---------------------------------------------------------------
# SQLite-файл создаётся относительно каталога запуска (miniapp/backend).
DATABASE_URL=sqlite:///./voting.db

# --- Local development ------------------------------------------------------
# 1 разрешает авторизацию через ?dev_user_id=<telegram_id>.
# В production обязательно оставьте 0.
DEV_MODE=0
DEV_USER_NAME=Тестовый Участник

# Время жизни Telegram initData в секундах. 0 отключает проверку возраста.
INIT_DATA_TTL_SECONDS=86400

# Разрешённые origins для frontend, если он открыт отдельно от API.
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000,http://localhost:8000

# --- Event defaults ---------------------------------------------------------
# Используются при первом создании карточки мероприятия.
# Дальше значения меняются в админ-панели и хранятся в event_settings.
EVENT_TITLE=Заседание Совета старост
EVENT_DATE=2026-11-16
EVENT_TIME=17:00
EVENT_PLACE=Зал Учёного совета
