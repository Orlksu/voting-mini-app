# Локальный запуск: cp .env.example .env  (docker compose читает .env автоматически).
# Демо-ключ MapTiler для проверки решения жюри; ключ публичный по природе —
# он попадает в JS-бандл и виден в браузере. После конкурса будет отозван.
VITE_MAPTILER_API_KEY=vb7bf7MS6wkwdLMVvQP3
VITE_API_URL=/api/v1

# Учётные данные локальной PostgreSQL (только для локального запуска).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=lctdb
